read -formal -D SYNTHESIS alu_unit.v control_unit.v crc_unit.v delay_counter.v engine_top.v fifo.v instr_mem.v loop_counter.v pc_reg.v pin_block.v shift_reg.v
read -formal engine_props.sv
prep -top engine_props

