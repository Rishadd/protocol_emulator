module adc_controller(
    input  wire        dout, 
    input  wire        adc_sck,
    output wire        adc_cs_n, 
    output wire        din, 
    output reg [11:0]  d_out_ch0
);
    reg [3:0]  din_counter = 0; 
    reg [3:0]  sp_counter = 0;
    reg        adc_cs = 1;
    reg [11:0] dout_chx = 0;

    // Toggle CS every 16 cycles
    always @(negedge adc_sck) begin
        din_counter <= din_counter + 1;
        if(din_counter == 15) adc_cs <= !adc_cs;
    end

    // Read bits 11-0 during cycles 4-15
    always @(posedge adc_sck) begin
        if((sp_counter >= 4) && (sp_counter <= 15)) begin
            dout_chx[15 - sp_counter] <= dout; 
        end
        sp_counter <= sp_counter + 1'b1;
    end

    // Update final output when frame is done
    always @(posedge adc_sck) begin
        if ((sp_counter == 15) && (!adc_cs)) begin
            d_out_ch0 <= dout_chx;
        end
    end

    assign adc_cs_n = adc_cs;
    assign din      = 1'b0; // Fixed to Channel 0
endmodule