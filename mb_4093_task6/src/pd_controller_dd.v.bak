module pd_control_dd(
    input  clk_50M,
    input  reset_n,
    input  signed [15:0] input_val,   // Sensor Distance
	 input signed [15:0]ref_val,
	 input signed [15:0]kp,kd,
	 input signed [6:0]clamp,
    output reg signed [6:0] corrected_val // 7-bit Output (-20 to +20)
);

    // ==========================================
    // Tuning Parameters
    // ==========================================
//    parameter signed [15:0] ref_val = 16'sd105; // Target Distance
//    parameter signed [15:0] kp      = 16'sd40; // Proportional Gain
//    parameter signed [15:0] kd      = 16'sd20; // Derivative Gain
    
    // Clock Prescaler (50MHz -> ~50Hz)
    parameter [31:0] clk_prescaler = 32'd1000000;

    // Internal State
    reg signed [15:0] prev_error;
    reg [31:0] clk_divider;
    reg flag; // Enable tick for PID calculation

    // Intermediate Math Variables
    // Using 'integer' or large regs ensures we don't overflow during multiplication
    reg signed [31:0] p_term;
    reg signed [31:0] d_term;
    reg signed [31:0] total;
    reg signed [15:0] error;
    
    // ==========================================
    // 1. Clock Divider (Generate low-freq tick)
    // ==========================================
    always @(posedge clk_50M or negedge reset_n) begin
        if (~reset_n) begin
            clk_divider <= 0;
            flag <= 0;
        end 
        else if (clk_divider >= clk_prescaler - 1) begin 
            clk_divider <= 0;
            flag <= 1; // Trigger PID calculation
        end 
        else begin
            clk_divider <= clk_divider + 1;
            flag <= 0;
        end
    end

    // ==========================================
    // 2. PD Calculation Logic
    // ==========================================
    always @(posedge clk_50M or negedge reset_n) begin
        if (~reset_n) begin
            prev_error    <= 16'sd0;
            corrected_val <= 7'sd0;
            error         <= 16'sd0;
        end 
        else if (flag) begin    
            // A. Calculate Error
            error = ref_val - input_val;

            // B. Calculate Terms (Blocking assignments for immediate math)
            p_term = kp * error;
            d_term = kd * (error - prev_error);

            // C. Sum and Scale
            // We divide by 10 to allow higher resolution in Kp/Kd parameters
            // e.g., Kp=20 becomes effective gain of 2.0
            total = (p_term + d_term)/10; // + d_term) / 10;

            // D. Clamp Output to +/- 20
            if (total > clamp) 
                corrected_val <= clamp;
            else if (total < -clamp) 
                corrected_val <= -clamp;
            else 
                corrected_val <= total[6:0]; // Safe to cast now
            
            // E. Store history for next derivative calc
            prev_error <= error;
        end
    end

endmodule