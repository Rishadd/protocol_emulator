module ir(
    input clk_50M, 
    input reset_n,
    input ir,
    output reg op
);

    reg [15:0] counter_1ms;

    always @(posedge clk_50M or negedge reset_n) begin
        if (!reset_n) begin
            counter_1ms <= 0;
            op <= 0;
        end
        else begin
            if (counter_1ms >= 49999) begin
                counter_1ms <= 0;
                op <= ~ir; 
            end
            else begin
                counter_1ms <= counter_1ms + 1;
            end
        end
    end

endmodule