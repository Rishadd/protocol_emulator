%% Core-internal block diagram — matches src/engine_top.v as of 2026-10-11.
%% Every block below exists and is unit-tested. Nothing here is protocol-specific.
%% Changes since 2026-10-03: `run` input (core held in reset while 0, FIFOs and memory kept) and the
%% instr_mem write port (imem_we/waddr/wdata, driven by the management block, only while run=0).
%% Planned: instr_mem becomes an SRAM macro with a next-PC fetch (see ASIC_AREA_AND_MEMORY_STUDY.md).
flowchart TD
    CLKRST(["clk, rst_n<br/>(fan to every sequential module)"])
    HOST(["Host side: management block<br/>(testbench / on-FPGA host for the FPGA builds)"])
    PADS(["8 protocol pins"])

    IMEM["<b>instr_mem</b> 64×32 (flops)<br/>─ in ─<br/>addr [5:0]<br/>we, waddr [5:0], wdata [31:0] (host, run=0 only)<br/>─ out ─<br/>instr [31:0]"]

    PCREG["<b>pc_reg</b><br/>─ in ─<br/>advance, jump<br/>jump_addr [5:0]<br/>─ out ─<br/>pc [5:0]"]

    CTRL["<b>control_unit</b><br/>opcode = instr[31:27], operand = instr[26:0]<br/>states: EXEC / HOLD<br/>─ in ─<br/>instr [31:0], dc_last<br/>lc_count [15:0]<br/>tx_empty, rx_full<br/>osr_bit, pin_in [7:0]<br/>─ out ─<br/>pc_advance, pc_jump, jump_addr<br/>dc_load, dc_load_value [26:0]<br/>lc_load, lc_dec, lc_load_value [15:0]<br/>tx_rd_en, rx_wr_en<br/>osr_load, osr_shift, isr_shift, isr_clear<br/>pin_wr, pin_wr_idx [2:0], pin_wr_val<br/>dir_wr, dir_wr_idx [2:0], dir_wr_val<br/>cfg_out_pin, cfg_in_pin, cfg_osr_msb, cfg_isr_msb<br/>halted, fault"]

    DCNT["<b>delay_counter</b> 27-bit<br/>─ in ─ load, load_value<br/>─ out ─ busy, last"]
    LCNT["<b>loop_counter</b> 16-bit<br/>─ in ─ load, load_value, dec<br/>─ out ─ count"]

    TXF["<b>fifo</b> tx_fifo 32×4<br/>─ in ─ wr_en, wr_data, rd_en<br/>─ out ─ full, empty, rd_data"]
    RXF["<b>fifo</b> rx_fifo 32×4<br/>─ in ─ wr_en, wr_data, rd_en<br/>─ out ─ full, empty, rd_data"]

    OSR["<b>shift_reg</b> OSR 32-bit<br/>─ in ─ msb_first, load, load_value, shift_out<br/>─ out ─ out_bit, data"]
    ISR["<b>shift_reg</b> ISR 32-bit<br/>─ in ─ msb_first, shift_in, in_bit, clear<br/>─ out ─ data"]

    PINS["<b>pin_block</b> 8 pins<br/>out/oe registers, 2-stage sync<br/>─ in ─ pin_wr*, dir_wr*, pin_in [7:0]<br/>─ out ─ pin_out [7:0], pin_oe [7:0], pin_in_sync [7:0]"]

    CLKRST --> PCREG & CTRL & DCNT & LCNT & TXF & RXF & OSR & ISR & PINS

    HOST -->|"imem_we, imem_waddr, imem_wdata (run=0 only)"| IMEM
    HOST -->|"run: 0 holds PC, control, counters, shifters, pins in reset"| CLKRST

    PCREG -->|pc| IMEM
    IMEM -->|instr| CTRL
    CTRL -->|pc_advance, pc_jump, jump_addr| PCREG

    CTRL -->|dc_load, dc_load_value| DCNT
    DCNT -->|last| CTRL
    CTRL -->|lc_load, lc_dec, lc_load_value| LCNT
    LCNT -->|count| CTRL

    HOST -->|tx_wr_en, tx_wr_data| TXF
    TXF -->|tx_full| HOST
    TXF -->|empty| CTRL
    CTRL -->|tx_rd_en| TXF
    TXF -->|rd_data| OSR
    CTRL -->|osr_load, osr_shift, cfg_osr_msb| OSR
    OSR -->|out_bit| CTRL

    CTRL -->|isr_shift, isr_clear, cfg_isr_msb| ISR
    PINS -->|"pin_in_sync[cfg_in_pin]"| ISR
    ISR -->|data| RXF
    CTRL -->|rx_wr_en| RXF
    RXF -->|full| CTRL
    HOST -->|rx_rd_en| RXF
    RXF -->|rx_rd_data, rx_empty| HOST

    CTRL -->|pin_wr, pin_wr_idx, pin_wr_val<br/>dir_wr, dir_wr_idx, dir_wr_val| PINS
    PINS -->|pin_in_sync| CTRL
    PINS <-->|pin_out, pin_oe / pin_in| PADS

    CTRL -->|halted, fault, pc| HOST
