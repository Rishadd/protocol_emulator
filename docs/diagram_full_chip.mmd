%% Full-chip block diagram, status as of 2026-10-11 (matches src/tt_um_protocol_emulator.v).
%% Solid = built and simulated. Dashed outline / "PLANNED" = not built yet.
flowchart LR
    HOST(["Host — Pico or testbench"])

    subgraph CHIP["Protocol Emulator ASIC (Tiny Tapeout tile)"]
        direction LR

        SPI["spi_slave<br/>mode 0, 2-flop sync,<br/>SCLK edge-detected<br/>BUILT"]
        MGMT["mgmt (frame v1, 7 bytes)<br/>per-engine RUN, program load,<br/>TX push, RX pop, STATUS, err<br/>BUILT — CRC / seq / ID PLANNED"]

        subgraph ENG0["Engine 0"]
            CORE0["engine_top<br/>control, PC, counters,<br/>OSR/ISR, TX/RX FIFO 32x4<br/>BUILT"]
            IMEM0["instr_mem 64x32<br/>(flops today)"]
        end

        subgraph ENG1["Engine 1"]
            CORE1["engine_top<br/>BUILT"]
            IMEM1["instr_mem 64x32<br/>(flops today)"]
        end

        SRAM["PLANNED: SRAM macros replace both flop memories<br/>4 x 1P 64x16, or one 2P 256x32 with page select<br/>(decision pending, see ASIC_AREA_AND_MEMORY_STUDY)"]

        MERGE["Pad merge today:<br/>oe = oe0 OR oe1, engine 0 wins<br/>BUILT (no ownership)"]
        PINMGR["pin_mgr — PLANNED<br/>owner per pad, claim/deny,<br/>violation flags, per-pad open-drain<br/>prototype 5.2k um^2, not simulated"]
        SAFETY["Safety latch — PLANNED<br/>abort pin, ena, synchronized release<br/>(reset sync + run gating exist)"]
    end

    IOPINS(["Tiny Tapeout IO<br/>ui_in[2:0] SCLK/MOSI/CS_N, uo_out[0] MISO,<br/>uio[7:0] protocol pins, clk, rst_n, ena"])

    HOST -- "SPI" --> IOPINS
    IOPINS --> SPI
    SPI <--> MGMT

    MGMT -- "RUN, imem write (RUN=0 only), TX push, RX pop, status" --> CORE0
    MGMT -- "RUN, imem write (RUN=0 only), TX push, RX pop, status" --> CORE1
    IMEM0 --- CORE0
    IMEM1 --- CORE1
    SRAM -. "replaces" .-> IMEM0
    SRAM -. "replaces" .-> IMEM1

    CORE0 -- "pin out + oe" --> MERGE
    CORE1 -- "pin out + oe" --> MERGE
    MERGE -- "uio[7:0]" --> IOPINS
    PINMGR -. "replaces" .-> MERGE
    SAFETY -. "disarm" .-> PINMGR

    classDef built fill:#dbeeff,stroke:#4a90d9,stroke-width:1px;
    classDef planned fill:#fff4d6,stroke:#d9a441,stroke-width:1px,stroke-dasharray: 4 3;
    class SPI,MGMT,CORE0,CORE1,IMEM0,IMEM1,MERGE built
    class SRAM,PINMGR,SAFETY planned
