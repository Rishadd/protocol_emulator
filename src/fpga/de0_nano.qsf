# Quartus Prime Lite project for the protocol emulator on the Terasic DE0-Nano.
# Pin assignments copied from the previous HardwareTest.qsf so the HC-05 wiring is unchanged.
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY de0_nano_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"

# ---- sources (engine core lives one directory up; SEARCH_PATH resolves `include "isa.vh") ----
set_global_assignment -name SEARCH_PATH ..
set_global_assignment -name VERILOG_FILE ../pc_reg.v
set_global_assignment -name VERILOG_FILE ../instr_mem.v
set_global_assignment -name VERILOG_FILE ../delay_counter.v
set_global_assignment -name VERILOG_FILE ../loop_counter.v
set_global_assignment -name VERILOG_FILE ../fifo.v
set_global_assignment -name VERILOG_FILE ../shift_reg.v
set_global_assignment -name VERILOG_FILE ../pin_block.v
set_global_assignment -name VERILOG_FILE ../control_unit.v
set_global_assignment -name VERILOG_FILE ../engine_top.v
set_global_assignment -name VERILOG_FILE msg_sender.v
set_global_assignment -name VERILOG_FILE de0_nano_top.v
set_global_assignment -name SDC_FILE de0_nano.sdc
set_global_assignment -name MISC_FILE uart_tx_prog.hex

# ---- clock and buttons ----
set_location_assignment PIN_R8  -to clk_50M
set_location_assignment PIN_J15 -to reset_n     ;# KEY0
set_location_assignment PIN_E1  -to start_n     ;# KEY1

# ---- HC-05 Bluetooth (GPIO-1 header, same as previous project) ----
set_location_assignment PIN_J14 -to bt_tx_pin   ;# FPGA TX -> HC-05 RXD
set_location_assignment PIN_J13 -to bt_rx_pin   ;# FPGA RX <- HC-05 TXD

# ---- LEDs (LED0..LED7); LED3=A11 from the DE0-Nano manual, others from the old qsf ----
set_location_assignment PIN_A15 -to led[0]
set_location_assignment PIN_A13 -to led[1]
set_location_assignment PIN_B13 -to led[2]
set_location_assignment PIN_A11 -to led[3]
set_location_assignment PIN_D1  -to led[4]
set_location_assignment PIN_F3  -to led[5]
set_location_assignment PIN_B1  -to led[6]
set_location_assignment PIN_L3  -to led[7]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
