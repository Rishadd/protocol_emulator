// UART TX 8N1, LSB first, out_pin=0. Bit period = D+2 cycles; D=432 -> 434 cycles = 115200 baud @ 50 MHz.
// Same program as tb_engine_top load_uart_prog(432). Word = {opcode[4:0], operand[26:0]}.
@00
80000000 // 00 CFG   0      out_pin=0, in_pin=0, LSB first
60000000 // 01 DIRO  0      drive pin 0
50000000 // 02 SETH  0      idle high
30000000 // 03 PULL         block until a byte is in tx_fifo, pop into OSR
20000008 // 04 SETL  8      8 data bits
58000000 // 05 SETLO 0      start bit
080001B0 // 06 WAIT  432
400001B0 // 07 OUT1  432    data bit (LSB first)
28000007 // 08 DJNZ  7
50000000 // 09 SETH  0      stop bit
080001B0 // 10 WAIT  432
10000003 // 11 JMP   3      next byte
@0C
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000 18000000 18000000 18000000 18000000
18000000 18000000 18000000 18000000
